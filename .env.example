# FixPilot configuration — copy to `.env` and edit.
# Every value below is optional; the defaults are the safe ones.
# The file is read by `fixpilot.config.load_dotenv`; real environment variables win.

# ---------------------------------------------------------------------------
# Repository & web server
# ---------------------------------------------------------------------------
# Repository FixPilot operates on (defaults to the current directory).
# FIXPILOT_REPO=/path/to/your/repo

# Bind address for the phone-facing server. 0.0.0.0 is required for a phone on
# the same network (or a proxied preview) to reach it.
FIXPILOT_HOST=0.0.0.0
FIXPILOT_PORT=8787

# ---------------------------------------------------------------------------
# Sign-in (login gate)
# ---------------------------------------------------------------------------
# true  → the phone must sign in before it can see the repo, approve a patch or
#         run a command. The FIRST account created becomes the owner.
# false → trusted-local mode (equivalent to `serve --no-auth`): no login, and
#         the page hands out a mutation token to anyone who can reach the port.
FIXPILOT_AUTH=true

# Self-service account creation from the login screen. Off by default on
# purpose: a server bound to 0.0.0.0 must not be enrol-able by strangers.
FIXPILOT_ALLOW_SIGNUP=false

# How long a sign-in lasts before the phone has to authenticate again.
FIXPILOT_AUTH_SESSION_HOURS=12

# ---------------------------------------------------------------------------
# Autonomy & approval
# ---------------------------------------------------------------------------
# true  → a human must approve every patch before it is written (default)
# false → patches are auto-approved; still validated, still rolled back on failure
FIXPILOT_REQUIRE_APPROVAL=true

# How many refined candidates may be tried after a failing test run.
FIXPILOT_MAX_REFINE_ITERATIONS=3

# Push the verified patch to the current branch when a session finishes.
FIXPILOT_AUTO_PUSH=false

# Market/demo behaviour: seed friendlier sample data and skip network probes.
FIXPILOT_DEMO_MODE=false

# ---------------------------------------------------------------------------
# Sandbox
# ---------------------------------------------------------------------------
# Per-command timeout (seconds) and the quick timeout for fast probes.
FIXPILOT_CMD_TIMEOUT=300
FIXPILOT_CMD_TIMEOUT_QUICK=60

# Output captured per command (bytes) and the patch size limits.
FIXPILOT_CMD_MAX_OUTPUT=262144
FIXPILOT_MAX_PATCH_BYTES=204800
FIXPILOT_MAX_PATCH_FILES=12

# Network access and dependency installation are confirmation-gated when true
# and denied outright when false.
FIXPILOT_ALLOW_NETWORK=false
FIXPILOT_ALLOW_DEP_INSTALL=false

# Extra command prefixes to allow (comma or newline separated), e.g.
# FIXPILOT_ALLOW_COMMANDS=make,terraform plan
FIXPILOT_ALLOW_COMMANDS=

# ---------------------------------------------------------------------------
# Models (local-first; deterministic fallback always available)
# ---------------------------------------------------------------------------
# local-first | local-only | cloud | deterministic
FIXPILOT_MODEL_STRATEGY=local-first

FIXPILOT_OLLAMA_URL=http://127.0.0.1:11434
FIXPILOT_OLLAMA_FAST=qwen2.5-coder:1.5b
FIXPILOT_OLLAMA_REASON=qwen2.5-coder:7b
FIXPILOT_OLLAMA_VISION=llama3.2-vision:11b

# Optional OpenAI-compatible endpoint. Leave the key empty to stay fully local.
# FIXPILOT_OPENAI_BASE_URL=https://api.openai.com/v1
# FIXPILOT_OPENAI_API_KEY=
FIXPILOT_OPENAI_MODEL=gpt-4o-mini

FIXPILOT_MODEL_TIMEOUT=120
FIXPILOT_MODEL_MAX_TOKENS=2048
FIXPILOT_MODEL_TEMPERATURE=0.1

# Allow the deterministic core to answer when no model is reachable.
FIXPILOT_ALLOW_OFFLINE_CORE=true
